<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#58E1FF</item>
        <item name="colorOnPrimary">#061421</item>
        <item name="colorSecondary">#8CA8FF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#050C1C</item>
        <item name="android:navigationBarColor">#050C1C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#070E1D</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#58E1FF</item>
    </style>

    <style name="Theme.Mark56.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050C1C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_jarvis</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
